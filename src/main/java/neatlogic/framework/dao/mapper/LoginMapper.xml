<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="neatlogic.framework.dao.mapper.LoginMapper">
    <cache type="neatlogic.framework.dao.cache.NeatLogicConcurrentSafeCache" flushInterval="300000" size="10"/>
    <select id="getLoginCaptchaBySessionId" parameterType="java.lang.String"
            resultType="neatlogic.framework.dto.captcha.LoginCaptchaVo" useCache="false">
        SELECT `session_id` as sessionId, `code`, `expired_time` as expiredTime
        FROM `login_captcha`
        WHERE `session_id` = #{value}
    </select>

    <select id="getLoginFailedCountByUserId" resultType="java.lang.Integer">
        SELECT `failed_count`
        FROM `login_failed_count`
        WHERE `user_id` = #{value}
    </select>

    <select id="getLoginFailedCountVoByUserId"
            resultType="neatlogic.framework.dto.captcha.LoginFailedCountVo">
        SELECT `failed_count` as failedCount, `user_id` as userId
        FROM `login_failed_count`
        WHERE `user_id` = #{value}
    </select>

    <select id="getLoginAuditCount" parameterType="neatlogic.framework.dto.loginaudit.LoginAuditSearchVo" resultType="int">
        SELECT
            count(1)
        FROM `login_audit` a
        <if test="keyword != null and keyword != ''">
            JOIN `user` b ON b.`uuid` = a.`user_uuid`
        </if>
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                b.`uuid` = #{keyword}
                OR b.`user_id` = #{keyword}
                OR b.`user_name` LIKE CONCAT(#{keyword}, '%')
                )
            </if>
            <if test="startTime != null and endTime != null">
                AND a.`login_time` &gt;= #{startTime}
                AND a.`login_time` &lt;= #{endTime}
            </if>
        </where>
    </select>

    <select id="getLoginAuditList" parameterType="neatlogic.framework.dto.loginaudit.LoginAuditSearchVo" resultType="neatlogic.framework.dto.loginaudit.LoginAuditVo">
        SELECT
            a.`id`,
            a.`user_uuid` AS userUuid,
            a.`login_time` AS loginTime,
            a.`login_method` AS loginMethod
        FROM `login_audit` a
        <if test="keyword != null and keyword != ''">
            JOIN `user` b ON b.`uuid` = a.`user_uuid`
        </if>
        <where>
            <if test="keyword != null and keyword != ''">
            AND (
                b.`uuid` = #{keyword}
                OR b.`user_id` = #{keyword}
                OR b.`user_name` LIKE CONCAT(#{keyword}, '%')
            )
            </if>
            <if test="startTime != null and endTime != null">
                AND a.`login_time` &gt;= #{startTime}
                AND a.`login_time` &lt;= #{endTime}
            </if>
        </where>
        ORDER BY `id` DESC
        LIMIT #{startNum}, #{pageSize}
    </select>

    <insert id="updateLoginCaptcha" parameterType="neatlogic.framework.dto.captcha.LoginCaptchaVo">
        INSERT INTO `login_captcha` (`session_id`, `code`, `expired_time`)
        VALUES (#{sessionId}, #{code}, #{expiredTime})
        ON DUPLICATE KEY
            UPDATE `code`         = #{code},
                   `expired_time` = #{expiredTime}
    </insert>

    <insert id="updateLoginFailedCount" parameterType="neatlogic.framework.dto.captcha.LoginFailedCountVo">
        INSERT INTO `login_failed_count` (`user_id`, `failed_count`)
        VALUES (#{userId}, #{failedCount})
        ON DUPLICATE KEY
            UPDATE failed_count = (failed_count + 1)
    </insert>

    <insert id="insertLoginAudit" parameterType="neatlogic.framework.dto.loginaudit.LoginAuditVo">
        INSERT INTO `login_audit`(`id`, `user_uuid`, `login_time`, `login_method`)
        VALUES (#{id}, #{userUuid}, NOW(3), #{loginMethod})
    </insert>

    <delete id="deleteLoginCaptchaBySessionId">
        delete
        from login_captcha
        where session_id = #{value}
    </delete>

    <delete id="deleteLoginInvalidCaptcha">
        DELETE
        FROM login_captcha
        WHERE NOW(3) > expired_time
    </delete>

    <delete id="deleteLoginFailedCountByUserId">
        delete
        from login_failed_count
        where user_id = #{value}
    </delete>

    <delete id="deleteLoginAuditByDayBefore" parameterType="java.lang.Integer">
        DELETE FROM `login_audit`
        WHERE `login_time` &lt; DATE_SUB(CURRENT_DATE, INTERVAL #{value} DAY)
    </delete>
</mapper>

