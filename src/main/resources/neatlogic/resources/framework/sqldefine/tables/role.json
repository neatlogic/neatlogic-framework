{
  "moduleId": "framework",
  "name": "role",
  "label": "角色表",
  "description": "角色表 可用于框架相关数据的查询、筛选和报表展示。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "自增ID，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "uuid",
      "type": "char(32)",
      "description": "uuid，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "角色名称。"
    },
    {
      "name": "description",
      "type": "varchar(500)",
      "description": "角色描述。"
    },
    {
      "name": "rule",
      "type": "text",
      "description": "生效规则。"
    },
    {
      "name": "is_delete",
      "type": "tinyint(1)",
      "description": "是否已删除。"
    },
    {
      "name": "env",
      "type": "varchar(50)",
      "description": "角色表的env字段。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "uuid"
      ],
      "description": "主键索引，覆盖 uuid 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "id",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "id"
      ],
      "description": "普通索引，覆盖 id 字段，适合用于过滤、关联或排序查询。"
    }
  ]
}
