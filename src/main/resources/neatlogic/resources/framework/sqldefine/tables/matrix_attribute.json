{
  "moduleId": "framework",
  "name": "matrix_attribute",
  "label": "矩阵自定义属性表",
  "description": "矩阵自定义属性表 可用于框架相关数据的查询、筛选和报表展示。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "自增id，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "uuid",
      "type": "char(32)",
      "description": "属性uuid。"
    },
    {
      "name": "matrix_uuid",
      "type": "char(32)",
      "description": "矩阵uuid，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "type",
      "type": "varchar(50)",
      "description": "属性类型。"
    },
    {
      "name": "is_required",
      "type": "tinyint(1)",
      "description": "属性是否必填。"
    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "属性名称。"
    },
    {
      "name": "unique_identifier",
      "type": "varchar(50)",
      "description": "属性唯一标识。"
    },
    {
      "name": "sort",
      "type": "int",
      "description": "排序。"
    },
    {
      "name": "config",
      "type": "mediumtext",
      "description": "属性配置。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "matrix_attribute_key",
      "type": "BTREE",
      "unique": true,
      "primary": false,
      "columns": [
        "matrix_uuid",
        "uuid"
      ],
      "description": "唯一索引，覆盖 matrix_uuid、uuid 字段，适合用于精确检索、唯一性判断和去重查询。"
    }
  ]
}
