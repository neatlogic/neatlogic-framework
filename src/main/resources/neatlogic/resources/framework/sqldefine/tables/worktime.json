{
  "moduleId": "framework",
  "name": "worktime",
  "label": "服务窗口",
  "description": "服务窗口 可用于框架相关的启用状态筛选、时间维度统计等报表查询场景。",
  "fields": [
    {
      "name": "uuid",
      "type": "varchar(50)",
      "description": "id，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "名称。"
    },
    {
      "name": "is_active",
      "type": "int",
      "description": "是否激活，1：激活，0：禁用。"
    },
    {
      "name": "lcu",
      "type": "varchar(50)",
      "description": "最后修改人。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "最后修改时间。"
    },
    {
      "name": "config",
      "type": "longtext",
      "description": "每周的工作时段定义。"
    },
    {
      "name": "is_delete",
      "type": "tinyint(1)",
      "description": "是否已删除。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "uuid"
      ],
      "description": "主键索引，覆盖 uuid 字段，适合用于唯一定位记录和主表关联查询。"
    }
  ]
}
