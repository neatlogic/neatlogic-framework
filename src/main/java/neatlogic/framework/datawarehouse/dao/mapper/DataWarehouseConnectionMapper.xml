<?xml version="1.0" encoding="UTF-8" ?>


<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="neatlogic.framework.datawarehouse.dao.mapper.DataWarehouseConnectionMapper">
    <select id="getConnectionById" parameterType="java.lang.Long"
            resultType="neatlogic.framework.datawarehouse.dto.ConnectionVo">
        select id,
               name,
               username,
               password as passwordCipher
        from report_connection
        where id = #{value}
    </select>
</mapper>
