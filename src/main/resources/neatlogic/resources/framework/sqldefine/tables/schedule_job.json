{
  "moduleId": "framework",
  "name": "schedule_job",
  "label": "定时作业信息表",
  "description": "定时作业信息表 可用于框架相关的启用状态筛选、时间维度统计等报表查询场景。",
  "fields": [
    {
      "name": "uuid",
      "type": "varchar(50)",
      "description": "全局唯一id，跨环境导入用，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(100)",
      "description": "名称。"
    },
    {
      "name": "handler",
      "type": "varchar(200)",
      "description": "处理器。"
    },
    {
      "name": "begin_time",
      "type": "timestamp(3)",
      "description": "开始时间。"
    },
    {
      "name": "end_time",
      "type": "timestamp(3)",
      "description": "结束时间。"
    },
    {
      "name": "cron",
      "type": "varchar(100)",
      "description": "corn表达式。"
    },
    {
      "name": "is_active",
      "type": "tinyint(1)",
      "description": "0:禁用，1:激活。"
    },
    {
      "name": "need_audit",
      "type": "tinyint(1)",
      "description": "0:不保存，1:保存。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "创建时间。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "uuid"
      ],
      "description": "主键索引，覆盖 uuid 字段，适合用于唯一定位记录和主表关联查询。"
    }
  ]
}
