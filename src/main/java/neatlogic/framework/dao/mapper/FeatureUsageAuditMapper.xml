<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="neatlogic.framework.dao.mapper.FeatureUsageAuditMapper">

    <sql id="getFeatureUsageAuditWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                <if test="menuName == null or menuName == ''">
                    AND `menu_name` like concat('%', #{keyword}, '%')
                </if>
            </if>
            <if test="moduleGroup != null and moduleGroup != ''">
                `module_group` = #{moduleGroup}
            </if>
            <if test="menuName != null and menuName != ''">
                `menu_name` = #{menuName}
            </if>
            <if test="startTime != null and endTime != null">
                AND `start_time` &gt;= #{startTime}
                AND `start_time` &lt;= #{endTime}
            </if>
            <if test="loginAuditId != null">
                `login_audit_id` = #{loginAuditId}
            </if>
        </where>
    </sql>

    <select id="getFeatureUsageAuditCount" parameterType="neatlogic.framework.dto.featureusageaudit.FeatureUsageAuditSearchVo" resultType="int">
        SELECT
            COUNT(1)
        FROM `feature_usage_audit`
        <include refid="getFeatureUsageAuditWhere"/>
    </select>

    <select id="getFeatureUsageAuditList" parameterType="neatlogic.framework.dto.featureusageaudit.FeatureUsageAuditSearchVo" resultType="neatlogic.framework.dto.featureusageaudit.FeatureUsageAuditVo">
        SELECT
            `id`,
            `user_uuid` AS userUuid,
            `module_group` AS moduleGroup,
            `menu_path` AS menuPath,
            `menu_name` AS menuName,
            `url`,
            `start_time` AS startTime,
            `end_time` AS endTime,
            `duration`,
            `login_audit_id` AS loginAuditId
        FROM `feature_usage_audit`
        <include refid="getFeatureUsageAuditWhere"/>
        LIMIT #{startNum}, #{pageSize}
    </select>

    <sql id="getFeatureWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                <if test="menuName == null or menuName == ''">
                    AND `menu_name` like concat('%', #{keyword}, '%')
                </if>
            </if>
            <if test="moduleGroup != null and moduleGroup != ''">
                `module_group` = #{moduleGroup}
            </if>
            <if test="menuName != null and menuName != ''">
                `menu_name` = #{menuName}
            </if>
            <if test="startTime != null and endTime != null">
                AND `start_time` &gt;= #{startTime}
                AND `start_time` &lt;= #{endTime}
            </if>
            <if test="loginAuditId != null">
                `login_audit_id` = #{loginAuditId}
            </if>
            <if test="userUuid != null and userUuid != ''">
                `user_uuid` = #{userUuid}
            </if>
        </where>
    </sql>

    <select id="getFeatureCount" parameterType="neatlogic.framework.dto.featureusageaudit.FeatureUsageAuditSearchVo" resultType="int">
        select COUNT(1) from (
            SELECT
            `module_group`, `menu_name`
            FROM `feature_usage_audit`
            <include refid="getFeatureWhere"/>
            GROUP BY `module_group`, `menu_name`
            ORDER BY `module_group`, `menu_name`
        ) a
    </select>

    <select id="getFeatureList" parameterType="neatlogic.framework.dto.featureusageaudit.FeatureUsageAuditSearchVo" resultType="neatlogic.framework.dto.featureusageaudit.FeatureUsageAuditVo">
        SELECT
        `module_group` AS moduleGroup,
        `menu_name` AS menuName,
        COUNT(1) AS usedCount
        FROM `feature_usage_audit`
        <include refid="getFeatureWhere"/>
        GROUP BY `module_group`, `menu_name`
        ORDER BY `module_group`, `menu_name`
        limit #{startNum}, #{pageSize}
    </select>

    <insert id="insertFeatureUsageAudit" parameterType="neatlogic.framework.dto.featureusageaudit.FeatureUsageAuditVo">
        INSERT INTO `feature_usage_audit`(
            `id`,
            `user_uuid`,
            `module_group`,
            `menu_name`,
            `menu_path`,
            `url`,
            `start_time`,
            `end_time`,
            `duration`,
            `login_audit_id`
        )
        VALUES (
            #{id},
            #{userUuid},
            #{moduleGroup},
            #{menuName},
            #{menuPath},
            #{url},
            #{startTime},
            #{endTime},
            #{duration},
            #{loginAuditId}
        )
    </insert>
</mapper>
