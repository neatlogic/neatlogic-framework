<?xml version="1.0" encoding="UTF-8" ?>


<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="neatlogic.framework.scheduler.dao.mapper.SchedulerMapper">

    <resultMap id="jobMap" type="neatlogic.framework.scheduler.dto.JobVo">
        <id column="uuid" property="uuid"/>
        <result column="name" property="name"/>
        <result column="handler" property="handler"/>
        <result column="cron" property="cron"/>
        <result column="is_active" property="isActive"/>
        <result column="need_audit" property="needAudit"/>
        <result column="begin_time" property="beginTime"/>
        <result column="end_time" property="endTime"/>
        <!-- 返回创建服务器ID，供前端表格展示和跨服务组数据排查使用。 -->
        <result column="server_id" property="sourceServerId"/>
        <result column="server_group" property="sourceServerGroup"/>
        <collection property="propList" ofType="neatlogic.framework.scheduler.dto.JobPropVo">
            <id column="prop_id" property="id"/>
            <result column="prop_name" property="name"/>
            <result column="prop_value" property="value" typeHandler="CompressHandler"/>
        </collection>
    </resultMap>

    <select id="getJobByUuid" parameterType="java.lang.String" resultMap="jobMap">
        SELECT a.uuid,
               a.name,
               a.handler,
               a.begin_time,
               a.end_time,
               a.cron,
               a.is_active,
               a.need_audit,
               c.server_id,
               c.server_group,
               d.prop_name,
               d.prop_value,
               d.id as prop_id
        FROM schedule_job a
                 LEFT JOIN schedule_job_prop d ON a.uuid = d.job_uuid
        LEFT JOIN `schedule_job_source` c ON c.`job_name` = a.`uuid`
        WHERE a.uuid = #{uuid}
    </select>

    <select id="getJobBaseInfoByUuid" parameterType="java.lang.String"
            resultType="neatlogic.framework.scheduler.dto.JobVo">
        SELECT `uuid`,
               `name`,
               `handler`,
               `begin_time` AS beginTime,
               `end_time`   AS endTime,
               `cron`,
               `is_active`  AS isActive,
               `need_audit` AS needAudit
        FROM `schedule_job`
        WHERE `uuid` = #{value}
    </select>


    <select id="getJobStatusByJobNameGroup" resultType="neatlogic.framework.scheduler.dto.JobStatusVo">
        <!--这是一级缓存的干扰器，不要删除 ${timestamp}-->
        SELECT `job_name` as jobName,
        `job_group` as jobGroup,
        `handler`,
        `last_fire_time` as lastFireTime,
        `last_finish_time` as lastFinishTime,
        `next_fire_time` as nextFireTime,
        `exec_count` as execCount
        FROM `schedule_job_status`
        WHERE `job_name` = #{jobName}
        AND `job_group` = #{jobGroup}
    </select>

    <select id="getJobByHandler" parameterType="java.lang.String" resultMap="jobMap">
        SELECT a.`uuid`,
               a.`name`,
               a.`handler`,
               a.`begin_time`,
               a.`end_time`,
               a.`cron`,
               a.`is_active`,
               a.`need_audit`,
               d.prop_name,
               d.prop_value,
               d.id as prop_id
        FROM `schedule_job` a
                 LEFT JOIN schedule_job_prop d ON a.uuid = d.job_uuid
        WHERE `handler` = #{value}
    </select>

    <sql id="searchJobWhere">
        WHERE
        (c.`job_name` IS NULL
        <choose>
            <when test="sourceServerGroup != null and sourceServerGroup != ''">
                OR c.`server_group` = #{sourceServerGroup}
            </when>
            <otherwise>
                OR c.`server_group` IS NULL
            </otherwise>
        </choose>
        )
        <if test="keyword != null and keyword != ''">
            AND a.name like CONCAT('%',#{keyword}, '%')
        </if>
        <if test="handler != null and handler != ''">
            AND a.handler = #{handler}
        </if>
        <if test="handlerList != null and handlerList.size() > 0">
            AND a.handler IN
            <foreach collection="handlerList" item="handlerClassName" open="(" separator="," close=")">
                #{handlerClassName}
            </foreach>
        </if>
        <if test="isActive != null">
            AND a.is_active = #{isActive}
        </if>
        <if test="needAudit != null">
            AND a.need_audit = #{needAudit}
        </if>
    </sql>

    <select id="searchJobCount" resultType="int">
        SELECT
        count(1)
        FROM schedule_job a
        LEFT JOIN `schedule_job_source` c ON c.`job_name` = a.`uuid`
        <include refid="searchJobWhere"/>
    </select>

    <resultMap id="jobDetailMap" type="neatlogic.framework.scheduler.dto.JobVo">
        <id column="uuid" property="uuid"/>
        <result column="name" property="name"/>
        <result column="handler" property="handler"/>
        <result column="cron" property="cron"/>
        <result column="is_active" property="isActive"/>
        <result column="need_audit" property="needAudit"/>
        <result column="begin_time" property="beginTime"/>
        <result column="end_time" property="endTime"/>
        <!-- 返回创建服务器ID，供前端表格展示和跨服务组数据排查使用。 -->
        <result column="server_id" property="sourceServerId"/>
        <result column="server_group" property="sourceServerGroup"/>
        <association property="jobStatus" resultMap="jobStatusMap"/>
    </resultMap>

    <resultMap id="jobStatusMap" type="neatlogic.framework.scheduler.dto.JobStatusVo">
        <result column="job_name" property="jobName"/>
        <result column="job_group" property="jobGroup"/>
        <result column="handler" property="handler"/>
        <result column="next_fire_time" property="nextFireTime"/>
        <result column="last_fire_time" property="lastFireTime"/>
        <result column="last_finish_time" property="lastFinishTime"/>
        <result column="exec_count" property="execCount"/>
    </resultMap>

    <select id="searchJob" resultMap="jobDetailMap">
        SELECT
        a.`uuid`,
        a.name,
        a.handler,
        a.`begin_time`,
        a.`end_time`,
        a.cron,
        a.is_active,
        a.need_audit,
        c.server_id,
        c.server_group,
        sjs.job_name,
        sjs.job_group,
        sjs.last_fire_time,
        sjs.last_finish_time,
        sjs.next_fire_time,
        sjs.exec_count
        FROM schedule_job a
        LEFT JOIN schedule_job_status sjs ON a.uuid = sjs.job_name
        LEFT JOIN `schedule_job_source` c ON c.`job_name` = a.`uuid`
        <include refid="searchJobWhere"/>
        ORDER BY a.`fcd` DESC
        limit #{startNum}, #{pageSize}
    </select>

    <select id="checkJobNameIsExists" parameterType="neatlogic.framework.scheduler.dto.JobVo" resultType="int">
        SELECT COUNT(1)
        FROM `schedule_job`
        WHERE `name` = #{name}
          AND `uuid` != #{uuid}
    </select>

    <sql id="searchJobAuditFrom">
        FROM `schedule_job_audit` a
        LEFT JOIN `schedule_job` sj ON a.job_uuid = sj.uuid
        LEFT JOIN (
            SELECT job_name, MIN(job_group) AS job_group, MIN(handler) AS handler
            FROM schedule_job_status
            GROUP BY job_name
        ) sjs ON a.job_uuid = sjs.job_name
        LEFT JOIN (
            SELECT job_name, MIN(job_group) AS job_group, MIN(job_handler) AS job_handler
            FROM schedule_job_lock
            GROUP BY job_name
        ) sjl ON a.job_uuid = sjl.job_name
    </sql>

    <sql id="searchJobAuditCountFrom">
        FROM `schedule_job_audit` a
        <!--只有按作业组、作业组件或所属模块过滤时，计数查询才需要关联运行态作业表。-->
        <if test="(jobGroupName != null and jobGroupName != '') or (jobHandler != null and jobHandler != '') or jobHandlerList != null">
            LEFT JOIN `schedule_job` sj ON a.job_uuid = sj.uuid
            LEFT JOIN (
                SELECT job_name, MIN(job_group) AS job_group, MIN(handler) AS handler
                FROM schedule_job_status
                GROUP BY job_name
            ) sjs ON a.job_uuid = sjs.job_name
            LEFT JOIN (
                SELECT job_name, MIN(job_group) AS job_group, MIN(job_handler) AS job_handler
                FROM schedule_job_lock
                GROUP BY job_name
            ) sjl ON a.job_uuid = sjl.job_name
        </if>
    </sql>

    <sql id="searchJobAuditCondition">
        <where>
            <if test="keyword != null and keyword != ''">
                and a.job_uuid LIKE concat('%', #{keyword}, '%')
            </if>
            <choose>
                <when test="jobUuid != null and jobUuid != ''">
                    and a.job_uuid = #{jobUuid}
                </when>
                <otherwise><!--如果不提供jobuuid，则搜索内部作业-->
                    and not exists (select 1 from schedule_job sj_filter where sj_filter.uuid = a.job_uuid)
                </otherwise>
            </choose>
            <if test="jobGroupName != null and jobGroupName != ''">
                and COALESCE(sjs.job_group, sjl.job_group) LIKE concat('%', #{jobGroupName}, '%')
            </if>
            <if test="jobHandler != null and jobHandler != ''">
                and COALESCE(sjs.handler, sjl.job_handler, sj.handler) = #{jobHandler}
            </if>
            <if test="jobHandlerList != null">
                <choose>
                    <when test="jobHandlerList.size() > 0">
                        and COALESCE(sjs.handler, sjl.job_handler, sj.handler) in
                        <foreach collection="jobHandlerList" item="jobHandlerClassName" open="(" separator="," close=")">
                            #{jobHandlerClassName}
                        </foreach>
                    </when>
                    <otherwise>
                        and 1 = 0
                    </otherwise>
                </choose>
            </if>
            <if test="status != null and status != ''">
                and a.status = #{status}
            </if>
            <if test="startTimeRange != null and startTimeRange.size() == 2">
                and (
                a.start_time &gt;= FROM_UNIXTIME(#{startTimeRange[0]})
                and
                a.start_time &lt;= FROM_UNIXTIME(#{startTimeRange[1]})
                )
            </if>
        </where>
    </sql>

    <select id="searchJobAuditCount" parameterType="neatlogic.framework.scheduler.dto.JobAuditVo" resultType="int">
        SELECT count(1)
        <include refid="searchJobAuditCountFrom"/>
        <include refid="searchJobAuditCondition"/>
    </select>

    <select id="searchJobAudit" parameterType="neatlogic.framework.scheduler.dto.JobAuditVo"
            resultType="neatlogic.framework.scheduler.dto.JobAuditVo">
        SELECT a.id,
        a.`job_uuid` AS jobUuid,
        a.`start_time` AS startTime,
        a.`end_time` AS endTime,
        a.`status`,
        a.server_id AS serverId,
        a.content_hash AS contentHash,
        a.`cron`,
        a.`next_fire_time` AS nextFireTime,
        COALESCE(sjs.job_group, sjl.job_group) AS jobGroupName,
        COALESCE(sjs.handler, sjl.job_handler, sj.handler) AS jobHandler
        <include refid="searchJobAuditFrom"/>
        <include refid="searchJobAuditCondition"/>
        ORDER BY a.`id` DESC
        LIMIT #{startNum}, #{pageSize}
    </select>

    <select id="checkJobAuditDetailIsExists" parameterType="java.lang.String" resultType="int">
        select count(1)
        from schedule_job_audit_detail
        where hash = #{value}
    </select>

    <select id="getJobAuditById" parameterType="java.lang.Long"
            resultType="neatlogic.framework.scheduler.dto.JobAuditVo">
        SELECT `id`,
               `job_uuid`       AS jobUuid,
               `start_time`     AS startTime,
               `end_time`       AS endTime,
               `content_hash`   AS contentHash,
               b.`content`,
               `status`,
               `server_id`      AS serverId,
               `cron`,
               `next_fire_time` AS nextFireTime
        FROM `schedule_job_audit` a
                 LEFT JOIN
             `schedule_job_audit_detail` b ON a.content_hash = b.hash
        WHERE id = #{value}
    </select>

    <select id="getJobAuditByUuid" parameterType="java.lang.String"
            resultType="neatlogic.framework.scheduler.dto.JobAuditVo">
        SELECT `id`,
               `job_uuid`       AS jobUuid,
               `start_time`     AS startTime,
               `end_time`       AS endTime,
               `content_hash`   AS contentHash,
               b.`content`,
               `status`,
               `server_id`      AS serverId,
               `cron`,
               `next_fire_time` AS nextFireTime
        FROM `schedule_job_audit` a
                 LEFT JOIN
             `schedule_job_audit_detail` b ON a.content_hash = b.hash
        WHERE job_uuid = #{value}
    </select>


    <select id="getJobLockByJobNameGroup" resultType="neatlogic.framework.scheduler.dto.JobLockVo">
        SELECT `job_name`    as jobName,
               `job_group`   as jobGroup,
               `job_handler` as jobHandler,
               `lock`,
               `server_id`   as serverId
        FROM `schedule_job_lock`
        WHERE job_name = #{jobName}
          AND job_group = #{jobGroup}
            FOR
        UPDATE
    </select>

    <select id="getJobLockByServerId" parameterType="java.lang.Integer"
            resultType="neatlogic.framework.scheduler.dto.JobLockVo">
        SELECT `job_name`    as jobName,
               `job_group`   as jobGroup,
               `job_handler` as jobHandler,
               `lock`,
               `server_id`   as serverId
        FROM `schedule_job_lock`
        WHERE server_id = #{value}
    </select>

    <!--<select id="getJobLoadTime" parameterType="neatlogic.framework.scheduler.dto.JobLoadTimeVo" resultType="neatlogic.framework.scheduler.dto.JobLoadTimeVo">
        SELECT
            `job_name` AS jobName,
            `job_group` AS jobGroup,
            `cron`,
            `load_time` AS loadTime
        FROM `schedule_job_load_time`
        WHERE `job_name` = #{jobName}
          AND `job_group` = #{jobGroup}
    </select>-->

    <select id="getJobLastExecAuditStartTime" resultType="java.lang.String">
        SELECT DATE_FORMAT(a.`start_time`, '%Y-%m-%d %H:%i:%s')
        FROM `schedule_job_audit` a
        WHERE a.job_uuid = #{jobUuid}
          AND a.`status` = #{status}
        ORDER BY a.end_time DESC
        LIMIT 1
    </select>

    <select id="getJobData" parameterType="neatlogic.framework.scheduler.dto.JobDataVo"
            resultType="neatlogic.framework.scheduler.dto.JobDataVo">
        select job_uuid as jobUuid,
        data_name as name,
        data_value as value
        from schedule_job_data
        where job_uuid = #{jobUuid}
        <if test="name != null and name != ''">
            and data_name = #{name}
        </if>
    </select>

    <select id="getJobLoadListByJobNameGroup" resultType="neatlogic.framework.scheduler.dto.JobLoadVo">
        SELECT
            `job_name` AS jobName,
            `job_group` AS jobGroup,
            `server_id` AS serverId,
            `server_start_time` AS serverStartTime
        FROM `schedule_job_load`
        WHERE `job_name` = #{jobName}
        AND `job_group` = #{jobGroup}
    </select>

    <select id="getJobSourceByJobNameAndJobGroup" resultType="neatlogic.framework.scheduler.dto.ScheduleJobSourceVo">
        SELECT
            `job_name` AS jobName,
            `job_group` AS jobGroup,
            `server_id` AS serverId,
            `server_group` AS serverGroup,
            `fcu`,
            `fcd`
        FROM `schedule_job_source`
        WHERE `job_name` = #{jobName}
          AND `job_group` = #{jobGroup}
    </select>

    <!-- 作业来源管理页的列表和计数共用相同查询条件，避免分页结果不一致。 -->
    <sql id="searchJobSourceWhere">
        <where>
            <!--<if test="keyword != null and keyword != ''">
                AND (
                    COALESCE(sj.`name`, s.`job_name`) LIKE CONCAT('%', #{keyword}, '%')
                    OR s.`job_group` LIKE CONCAT('%', #{keyword}, '%')
                    OR COALESCE(sj.`handler`, sjs.`handler`, sjl.`job_handler`) LIKE CONCAT('%', #{keyword}, '%')
                    OR CAST(s.`server_id` AS CHAR) LIKE CONCAT('%', #{keyword}, '%')
                    OR s.`server_group` LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>-->
            <if test="keyword != null and keyword != ''">
                s.`job_group` LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </sql>

    <!-- 关联配置表和运行态表，仅用于补充作业来源管理页的显示名称与作业模块。 -->
    <sql id="searchJobSourceFrom">
        FROM `schedule_job_source` s
        LEFT JOIN `schedule_job` sj
            ON sj.`uuid` = s.`job_name`
        LEFT JOIN `schedule_job_status` sjs
            ON sjs.`job_name` = s.`job_name`
            AND sjs.`job_group` = s.`job_group`
        LEFT JOIN `schedule_job_lock` sjl
            ON sjl.`job_name` = s.`job_name`
            AND sjl.`job_group` = s.`job_group`
    </sql>

    <select id="searchJobSourceCount" parameterType="neatlogic.framework.scheduler.dto.ScheduleJobSourceSearchVo" resultType="int">
        SELECT COUNT(1)
        <include refid="searchJobSourceFrom"/>
        <include refid="searchJobSourceWhere"/>
    </select>

    <select id="searchJobSource" parameterType="neatlogic.framework.scheduler.dto.ScheduleJobSourceSearchVo"
            resultType="neatlogic.framework.scheduler.dto.ScheduleJobSourceVo">
        SELECT s.`job_name` AS jobName,
               s.`job_group` AS jobGroup,
               s.`server_id` AS serverId,
               s.`server_group` AS serverGroup,
               s.`fcu`,
               s.`fcd`
        <include refid="searchJobSourceFrom"/>
        <include refid="searchJobSourceWhere"/>
        ORDER BY s.`fcd` DESC, s.`job_name`, s.`job_group`
        LIMIT #{startNum}, #{pageSize}
    </select>

    <!-- 返回全部非空服务器组；编辑控件仍允许录入新的服务器组。 -->
    <!--<select id="getJobSourceServerGroupList" resultType="java.lang.String">
        SELECT DISTINCT `server_group`
        FROM `schedule_job_source`
        WHERE `server_group` IS NOT NULL
          AND `server_group` != ''
        ORDER BY `server_group`
    </select>-->

    <update id="resetJobLockByServerId" parameterType="java.lang.Integer">
        UPDATE
            `schedule_job_lock`
        SET `lock` = 'waiting'
        WHERE `server_id` = #{value}
          AND `lock` = 'running'
    </update>

    <update id="updateJob" parameterType="neatlogic.framework.scheduler.dto.JobVo">
        UPDATE schedule_job
        SET name       = #{name},
            begin_time = #{beginTime},
            end_time   = #{endTime},
            cron       = #{cron},
            is_active  = #{isActive},
            need_audit = #{needAudit}
        WHERE uuid = #{uuid}
    </update>

    <!-- 使用(job_name, job_group)复合主键批量修改服务器组，兼容单行编辑和批量编辑。 -->
    <!--<update id="updateJobSourceServerGroup">
        UPDATE `schedule_job_source`
        SET `server_group` = #{serverGroup}
        WHERE (`job_name`, `job_group`) IN
        <foreach collection="jobSourceList" item="jobSource" open="(" separator="," close=")">
            (#{jobSource.jobName}, #{jobSource.jobGroup})
        </foreach>
    </update>-->

    <update id="updateJobStatus" parameterType="neatlogic.framework.scheduler.dto.JobStatusVo">
        UPDATE schedule_job_status
        SET next_fire_time   = #{nextFireTime},
            last_finish_time = #{lastFinishTime},
            last_fire_time   = #{lastFireTime},
            exec_count       = #{execCount},
            `lcd`            = NOW()
        WHERE job_name = #{jobName}
          AND job_group = #{jobGroup}
    </update>

    <update id="updateJobNextFireTime" parameterType="neatlogic.framework.scheduler.dto.JobStatusVo">
        UPDATE schedule_job_status
        SET next_fire_time = #{nextFireTime},
            `lcd`          = NOW()
        WHERE job_name = #{jobName}
          and job_group = #{jobGroup}
    </update>

    <update id="updateJobAudit" parameterType="neatlogic.framework.scheduler.dto.JobAuditVo">
        UPDATE schedule_job_audit
        SET end_time     = now(3),
            status       = #{status},
            content_hash = #{contentHash}
        WHERE id = #{id}
    </update>

    <update id="updateJobLock" parameterType="neatlogic.framework.scheduler.dto.JobLockVo">
        UPDATE `schedule_job_lock`
        SET `server_id` = #{serverId},
            `lock`      = #{lock}
        WHERE job_name = #{jobName}
          AND job_group = #{jobGroup}
    </update>

    <insert id="saveJobData" parameterType="neatlogic.framework.scheduler.dto.JobDataVo">
        insert into schedule_job_data
            (job_uuid, data_name, data_value)
        values (#{jobUuid}, #{name}, #{value})
        ON DUPLICATE KEY UPDATE data_value = #{value}
    </insert>

    <insert id="insertJobAuditDetail">
        INSERT IGNORE
        INTO schedule_job_audit_detail (hash, content)
        values (#{hash},
                #{content,typeHandler=CompressHandler})
    </insert>

    <insert id="insertJob" parameterType="neatlogic.framework.scheduler.dto.JobVo">
        INSERT INTO schedule_job
        (`uuid`,
         `name`,
         `handler`,
         `begin_time`,
         `end_time`,
         `cron`,
         `is_active`,
         `need_audit`,
         `fcd`)
        VALUES (#{uuid},
                #{name},
                #{handler},
                #{beginTime},
                #{endTime},
                #{cron},
                #{isActive},
                #{needAudit},
                NOW(3))
    </insert>

    <insert id="insertJobSource" parameterType="neatlogic.framework.scheduler.dto.ScheduleJobSourceVo">
        INSERT IGNORE INTO schedule_job_source
        (`job_name`,
         `job_group`,
         `server_id`,
         `server_group`,
         `fcu`,
         `fcd`)
        VALUES (#{jobName},
                #{jobGroup},
                #{serverId},
                #{serverGroup},
                #{fcu},
                NOW(3))
    </insert>

    <insert id="insertJobSourceList" parameterType="neatlogic.framework.scheduler.dto.ScheduleJobSourceVo">
        INSERT INTO schedule_job_source
        (`job_name`,
         `job_group`,
         `server_id`,
         `server_group`,
         `fcu`,
         `fcd`)
        VALUES
        <foreach collection="list" item="item" separator=",">
        (
             #{item.jobName},
             #{item.jobGroup},
             #{item.serverId},
             #{item.serverGroup},
             #{item.fcu},
             NOW(3)
        )
        </foreach>
        ON DUPLICATE KEY UPDATE
            `server_group` = VALUES(`server_group`)
    </insert>

    <insert id="insertJobStatus" parameterType="neatlogic.framework.scheduler.dto.JobStatusVo">
        INSERT INTO schedule_job_status
        (`job_name`,
         `job_group`,
         `handler`,
         `next_fire_time`,
         `fcd`)
        VALUES (#{jobName},
                #{jobGroup},
                #{handler},
                #{nextFireTime},
                NOW())
    </insert>

    <insert id="insertJobProp">
        INSERT schedule_job_prop (job_uuid, prop_name, prop_value)
        VALUES (#{jobUuid},
                #{name},
                #{value, typeHandler=CompressHandler})
    </insert>

    <insert id="insertJobAudit" parameterType="neatlogic.framework.scheduler.dto.JobAuditVo">
        INSERT INTO schedule_job_audit (id, job_uuid, start_time, status, server_id, cron, next_fire_time)
        VALUES (#{id}, #{jobUuid}, now(3), #{status}, #{serverId}, #{cron}, #{nextFireTime})
    </insert>

    <insert id="insertJobLock" parameterType="neatlogic.framework.scheduler.dto.JobLockVo">
        INSERT IGNORE INTO `schedule_job_lock` (`job_name`,
                                                `job_group`,
                                                `job_handler`,
                                                `lock`,
                                                `server_id`)
        VALUES (#{jobName},
                #{jobGroup},
                #{jobHandler},
                #{lock},
                #{serverId})
    </insert>

    <insert id="insertJobLoad" parameterType="neatlogic.framework.scheduler.dto.JobLoadVo">
        INSERT INTO `schedule_job_load` (
            `job_name`,
            `job_group`,
            `server_id`,
            `server_start_time`
        )
        VALUES
            (
                #{jobName},
                #{jobGroup},
                #{serverId},
                #{serverStartTime}
            )
        ON DUPLICATE KEY UPDATE `server_start_time` = #{serverStartTime}
    </insert>

    <!--<insert id="insertJobLoadTime" parameterType="neatlogic.framework.scheduler.dto.JobLoadTimeVo">
